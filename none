/* =====================================================
   SAP CONNECTION
===================================================== */

async function checkConnection() {

    const dot =
        document.getElementById(
            "connectionDot"
        );


    const text =
        document.getElementById(
            "connectionText"
        );


    try {

        const response =
            await fetch(
                "http://localhost:8000/check_connection"
            );


        if (!response.ok) {

            throw new Error(
                "SAP connection failed"
            );

        }


        dot.classList.remove(
            "disconnected"
        );

        dot.classList.add(
            "connected"
        );


        text.textContent =
            "SAP Connected";

    }
    catch (error) {

        dot.classList.remove(
            "connected"
        );

        dot.classList.add(
            "disconnected"
        );


        text.textContent =
            "SAP Disconnected";


        console.error(
            error
        );

    }

}



/* =====================================================
   NEW REVIEW
===================================================== */

function newReview() {

    sessionStorage.removeItem(
        "reviewData"
    );


    sessionStorage.removeItem(
        "transportRequest"
    );


    window.location.href =
        "index.html";

}



/* =====================================================
   OBJECT ICON
===================================================== */

function getObjectIcon(type) {

    const value =
        (type || "").toUpperCase();


    if (
        value.includes("CLAS") ||
        value.includes("CLASS")
    ) {

        return "CL";

    }


    if (
        value.includes("PROG") ||
        value.includes("PROGRAM")
    ) {

        return "PG";

    }


    if (
        value.includes("DDL")
    ) {

        return "DD";

    }


    if (
        value.includes("SRV") ||
        value.includes("SERV")
    ) {

        return "SV";

    }


    return "AB";

}


function getObjectIconClass(type) {

    const value =
        (type || "").toUpperCase();


    if (
        value.includes("CLAS") ||
        value.includes("CLASS")
    ) {

        return "class-icon";

    }


    if (
        value.includes("PROG") ||
        value.includes("PROGRAM")
    ) {

        return "program-icon";

    }


    if (
        value.includes("DDL")
    ) {

        return "ddl-icon";

    }


    if (
        value.includes("SRV") ||
        value.includes("SERV")
    ) {

        return "service-icon";

    }


    return "class-icon";

}



/* =====================================================
   SEVERITY HELPERS
===================================================== */

function normalizeSeverity(
    severity
) {

    if (!severity) {

        return "";

    }


    return String(
        severity
    ).trim().toUpperCase();

}


function getAISeverityClass(
    severity
) {

    if (
        severity === "ERROR" ||
        severity === "CRITICAL" ||
        severity === "HIGH"
    ) {

        return "error-label";

    }


    if (
        severity === "WARNING" ||
        severity === "MEDIUM"
    ) {

        return "warning-label";

    }


    return "status-good";

}



/* =====================================================
   HTML ESCAPE
===================================================== */

function escapeHTML(value) {

    if (
        value === null ||
        value === undefined
    ) {

        return "";

    }


    return String(value)
        .replaceAll(
            "&",
            "&amp;"
        )
        .replaceAll(
            "<",
            "&lt;"
        )
        .replaceAll(
            ">",
            "&gt;"
        )
        .replaceAll(
            '"',
            "&quot;"
        )
        .replaceAll(
            "'",
            "&#039;"
        );

}
