        document.getElementById(
            "chatInput"
        );


    const message =
        input.value.trim();


    if (message === "") {

        return;

    }


    /*
     * Display user's message.
     */

    const messages =
        document.getElementById(
            "chatMessages"
        );


    messages.innerHTML += `

        <div class="user-message">

