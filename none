/* =====================================================
   GLOBAL DATA
===================================================== */

let reviewData = [];

let selectedObjectIndex = 0;


/* =====================================================
   PAGE LOAD
===================================================== */

document.addEventListener(
    "DOMContentLoaded",
    function () {

        loadReviewData();

        checkConnection();

    }
);



/* =====================================================
   LOAD DATA FROM SESSION STORAGE
===================================================== */

function loadReviewData() {

    const storedData =
        sessionStorage.getItem("reviewData");

    const transportRequest =
        sessionStorage.getItem(
            "transportRequest"
        );


    /*
     * If the user directly opens review.html
     * without going through the first page.
     */

    if (!storedData) {

        alert(
            "No review data available."
        );

        window.location.href =
            "index.html";

        return;

    }


    try {

        reviewData =
            JSON.parse(storedData);


        /*
         * Make sure response is an array.
         */

        if (!Array.isArray(reviewData)) {

            throw new Error(
                "Review data is not an array."
            );

        }


        /*
         * Display transport request.
         */

        document.getElementById(
            "transportNumber"
        ).textContent =
            transportRequest || "-";


        document.getElementById(
            "objectCount"
        ).textContent =
            reviewData.length;


        /*
         * Create object list.
         */

        renderObjectList();


        /*
         * Automatically select first object.
         */

        if (reviewData.length > 0) {

            selectObject(0);

        }

    }
    catch (error) {

        console.error(
            "Failed to load review data:",
            error
        );

        alert(
            "Unable to read review data."
        );

    }

}



/* =====================================================
   RENDER OBJECT LIST
===================================================== */

function renderObjectList() {

    const objectList =
        document.getElementById(
            "objectList"
        );


    objectList.innerHTML = "";


    reviewData.forEach(
        function (object, index) {

            const checks =
                Array.isArray(
                    object.atc_checks
                )
                    ? object.atc_checks
                    : [];


            const errors =
                checks.filter(
                    check =>
                        normalizeSeverity(
                            check.severity
                        ) === "ERROR"
                ).length;


            const warnings =
                checks.filter(
                    check =>
                        normalizeSeverity(
                            check.severity
                        ) === "WARNING"
                ).length;


            const icon =
                getObjectIcon(
                    object.object_type
                );


            const iconClass =
                getObjectIconClass(
                    object.object_type
                );


            let findings = "";


            if (errors > 0) {

                findings += `
                    <span class="error-badge">
                        ${errors} Error${errors > 1 ? "s" : ""}
                    </span>
                `;

            }


            if (warnings > 0) {

                findings += `
                    <span class="warning-badge">
                        ${warnings} Warning${warnings > 1 ? "s" : ""}
                    </span>
                `;

            }


            if (
                errors === 0 &&
                warnings === 0
            ) {

                findings = `
                    <span class="clean-badge">
                        Clean
                    </span>
                `;

            }


            const row =
                document.createElement("div");


            row.className =
                "object-row";


            row.onclick =
                function () {

                    selectObject(index);

                };


            row.innerHTML = `

                <div
                    class="object-icon ${iconClass}"
                >
                    ${icon}
                </div>


                <div class="object-details">

                    <div class="object-name">
                        ${escapeHTML(
                            object.object_name
                        )}
                    </div>

                    <div class="object-type">
                        ${escapeHTML(
                            object.object_type
                        )}
                    </div>

                </div>


                <div class="object-findings">

                    ${findings}

                </div>


                <div class="arrow">
                    →
                </div>

            `;


            objectList.appendChild(row);

        }
    );

}



/* =====================================================
   SELECT OBJECT
===================================================== */

function selectObject(index) {

    if (
        index < 0 ||
        index >= reviewData.length
    ) {

        return;

    }


    selectedObjectIndex =
        index;


    const object =
        reviewData[index];


    /*
     * Highlight selected object.
     */

    const rows =
        document.querySelectorAll(
            ".object-row"
        );


    rows.forEach(
        function (row, rowIndex) {

            row.classList.toggle(
                "active",
                rowIndex === index
            );

        }
    );


    /*
     * Update main object information.
     */

    displayObjectHeader(
        object
    );


    /*
     * Render source code.
     */

    renderSourceCode(
        object
    );


    /*
     * Render ATC findings.
     */

    renderATCResults(
        object
    );


    /*
     * Render AI review.
     */

    renderAIReview(
        object
    );


    /*
     * Reset to Source Code tab
     * whenever a new object is selected.
     */

    switchTab("source");


    /*
     * Open chatbot automatically.
     */

    openChatForObject(
        object
    );

}



/* =====================================================
   OBJECT HEADER
===================================================== */

function displayObjectHeader(object) {

    document.getElementById(
        "objectName"
    ).textContent =
        object.object_name || "-";


    document.getElementById(
        "objectDescription"
    ).textContent =
        object.object_desc ||
        object.object_info ||
        "No description available";


    document.getElementById(
        "objectTypeBadge"
    ).textContent =
        object.object_type || "-";


    document.getElementById(
        "breadcrumbObject"
    ).textContent =
        object.object_name || "-";


    document.getElementById(
        "codeFileName"
    ).textContent =
        object.object_name || "-";

}



/* =====================================================
   SOURCE CODE
===================================================== */

function renderSourceCode(object) {

    const sourceCode =
        object.source_code || "";


    const sourceElement =
        document.getElementById(
            "sourceCode"
        );


    sourceElement.textContent =
        sourceCode;


    /*
     * Calculate number of lines.
     */

    const lines =
        sourceCode === ""
            ? 0
            : sourceCode.split("\n").length;


    document.getElementById(
        "lineCount"
    ).textContent =
        `${lines} lines`;


    /*
     * Generate line numbers.
     */

    const lineNumbers =
        document.getElementById(
            "lineNumbers"
        );


    lineNumbers.innerHTML = "";


    for (
        let i = 1;
        i <= lines;
        i++
    ) {

        lineNumbers.innerHTML +=
            `${i}<br>`;

    }

}



/* =====================================================
   ATC RESULTS
===================================================== */

function renderATCResults(object) {

    const container =
        document.getElementById(
            "atcContainer"
        );


    const checks =
        Array.isArray(
            object.atc_checks
        )
            ? object.atc_checks
            : [];


    document.getElementById(
        "atcCount"
    ).textContent =
        checks.length;


    document.getElementById(
        "atcSummary"
    ).textContent =
        `${checks.length} finding${
            checks.length !== 1 ? "s" : ""
        }`;


    container.innerHTML = "";


    if (checks.length === 0) {

        container.innerHTML = `

            <div class="no-results">

                <div class="no-results-icon">
                    ✓
                </div>

                No ATC findings were reported
                for this object.

            </div>

        `;

        return;

    }


    checks.forEach(
        function (check) {

            const severity =
                normalizeSeverity(
                    check.severity
                );


            const isError =
                severity === "ERROR";


            const finding =
                document.createElement(
                    "div"
                );


            finding.className =
                `finding ${
                    isError
                        ? "error"
                        : "warning"
                }`;


            finding.innerHTML = `

                <div class="finding-icon">

                    ${
                        isError
                            ? "!"
                            : "!"
                    }

                </div>


                <div class="finding-content">

                    <div class="finding-message">

                        ${escapeHTML(
                            check.message ||
                            "No message provided"
                        )}

                    </div>


                    <div class="finding-source">

                        ${escapeHTML(
                            check.source ||
                            "Source location not provided"
                        )}

                    </div>


                    <div class="finding-recommendation">

                        <strong>
                            Recommendation:
                        </strong>

                        ${
                            escapeHTML(
                                check.recommendation ||
                                "No recommendation provided."
                            )
                        }

                    </div>

                </div>


                <span
                    class="
                        severity-label
                        ${
                            isError
                                ? "error-label"
                                : "warning-label"
                        }
                    "
                >
                    ${escapeHTML(
                        severity || "UNKNOWN"
                    )}
                </span>

            `;


            container.appendChild(
                finding
            );

        }
    );

}



/* =====================================================
   AI REVIEW
===================================================== */

function renderAIReview(object) {

    const aiReviews =
        Array.isArray(
            object.ai_code_review
        )
            ? object.ai_code_review
            : [];


    document.getElementById(
        "aiCount"
    ).textContent =
        aiReviews.length;


    /*
     * Overall assessment
     */

    renderOverallAssessment(
        object.ai_overall_assessment
    );


    /*
     * AI findings
     */

    const container =
        document.getElementById(
            "aiContainer"
        );


    container.innerHTML = "";


    if (aiReviews.length === 0) {

        container.innerHTML = `

            <div class="no-results">

                <div class="no-results-icon">
                    ✦
                </div>

                No AI findings are available
                for this object.

            </div>

        `;

        return;

    }


    aiReviews.forEach(
        function (review) {

            const card =
                document.createElement(
                    "div"
                );


            card.className =
                "ai-card";


            const severity =
                normalizeSeverity(
                    review.severity
                );


            card.innerHTML = `

                <div class="ai-card-header">

                    <div class="ai-category">

                        ${escapeHTML(
                            review.category ||
                            "Code Quality"
                        )}

                    </div>


                    <span
                        class="
                            ai-severity
                            ${getAISeverityClass(
                                severity
                            )}
                        "
                    >

                        ${escapeHTML(
                            severity ||
                            "INFO"
                        )}

                    </span>

                </div>


                <div class="ai-finding">

                    <strong>
                        Finding
                    </strong>

                    <br>

                    ${escapeHTML(
                        review.findings ||
                        "No finding provided."
                    )}

                </div>


                ${
                    review.comment
                        ? `

                            <div class="ai-comment">

                                ${escapeHTML(
                                    review.comment
                                )}

                            </div>

                        `
                        : ""
                }


                ${
                    review.recommendation
                        ? `

                            <div class="recommendation">

                                <div class="recommendation-title">

                                    Recommendation

                                </div>

                                <div class="recommendation-text">

                                    ${escapeHTML(
                                        review.recommendation
                                    )}

                                </div>

                            </div>

                        `
                        : ""
                }


                ${
                    review.code_reference
                        ? `

                            <div>

                                <div class="recommendation-title">

                                    Code Reference

                                </div>

                                <div class="code-reference">

                                    ${escapeHTML(
                                        review.code_reference
                                    )}

                                </div>

                            </div>

                        `
                        : ""
                }

            `;


            container.appendChild(
                card
            );

        }
    );

}



/* =====================================================
   OVERALL AI ASSESSMENT
===================================================== */

function renderOverallAssessment(
    assessment
) {

    const container =
        document.getElementById(
            "overallAssessment"
        );


    if (!assessment) {

        container.innerHTML = `

            <div class="assessment-header">

                <div class="assessment-title">
                    OVERALL ASSESSMENT
                </div>

            </div>

            <div class="assessment-summary">
                No overall AI assessment available.
            </div>

        `;

        return;

    }


    const status =
        assessment.status || "UNKNOWN";


    const statusUpper =
        status.toUpperCase();


    let statusClass =
        "status-good";


    if (
        statusUpper.includes("ERROR") ||
        statusUpper.includes("CRITICAL") ||
        statusUpper.includes("FAIL")
    ) {

        statusClass =
            "status-error";

    }
    else if (
        statusUpper.includes("WARNING") ||
        statusUpper.includes("MODERATE") ||
        statusUpper.includes("ATTENTION")
    ) {

        statusClass =
            "status-warning";

    }


    container.innerHTML = `

        <div class="assessment-header">

            <div class="assessment-title">

                OVERALL ASSESSMENT

            </div>


            <span
                class="
                    assessment-status
                    ${statusClass}
                "
            >

                ${escapeHTML(
                    status
                )}

            </span>

        </div>


        <div class="assessment-summary">

            ${escapeHTML(
                assessment.Summary ||
                assessment.summary ||
                "No summary available."
            )}

        </div>

    `;

}



/* =====================================================
   TAB SWITCHING
===================================================== */

function switchTab(tabName) {

    /*
     * Remove active state from buttons.
     */

    document.querySelectorAll(
        ".tab"
    ).forEach(
        function (tab) {

            tab.classList.remove(
                "active"
            );

        }
    );


    /*
     * Hide all content.
     */

    document.querySelectorAll(
        ".tab-content"
    ).forEach(
        function (content) {

            content.classList.remove(
                "active"
            );

        }
    );


    /*
     * Activate selected tab.
     */

    const selectedButton =
        document.querySelector(
            `.tab[data-tab="${tabName}"]`
        );


    if (selectedButton) {

        selectedButton.classList.add(
            "active"
        );

    }


    const selectedContent =
        document.getElementById(
            `${tabName}Tab`
        );


    if (selectedContent) {

        selectedContent.classList.add(
            "active"
        );

    }

}



/* =====================================================
   CHATBOT
===================================================== */

function toggleChat() {

    const chatbot =
        document.getElementById(
            "chatbot"
        );


    chatbot.classList.toggle(
        "open"
    );

}


function openChatForObject(
    object
) {

    const chatbot =
        document.getElementById(
            "chatbot"
        );


    chatbot.classList.add(
        "open"
    );


    const messages =
        document.getElementById(
            "chatMessages"
        );


    messages.innerHTML = `

        <div class="bot-message">

            I'm ready to help you review

            <strong>
                ${escapeHTML(
                    object.object_name
                )}
            </strong>.

            <br><br>

            You can ask about its
            source code, ATC findings,
            or AI recommendations.

        </div>

    `;

}



/* =====================================================
   CHAT SUBMIT
===================================================== */

