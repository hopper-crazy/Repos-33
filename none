from sap_cloud_sdk.destination import create_client, DestinationHttpClient

client = create_client(instance="default")

destination = client.get_destination("DS4-010")

http = DestinationHttpClient(destination)

response = http.request(
    "GET",
    "/sap/bc/adt/api/atc/runs/csrf",
    headers={"X-CSRF-Token": "Fetch"}
)

print(response.status_code)
print(response.text)
