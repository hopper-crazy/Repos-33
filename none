import requests
import time


class ADTAPI:

    # =====================================================
    # INITIALIZE CONNECTION
    # =====================================================

    def __init__(self, base_url, username, password):

        self.base_url = base_url
        self.session = requests.Session()

        self.session.auth = (
            username,
            password
        )


    # =====================================================
    # 1. GET CSRF TOKEN
    # =====================================================

    def get_csrf_token(self):

        CSRF_URL = (
            self.base_url
            + "/sap/bc/adt/api/atc/runs/"
            + "00000000000000000000000000000000"
        )

        response = self.session.get(
            CSRF_URL,
            headers={
                "x-csrf-token": "fetch"
            }
        )

        response.raise_for_status()

        csrf_token = response.headers["x-csrf-token"]

        return csrf_token


    # =====================================================
    # 2. POST ATC CHECK RUN
    # =====================================================

    def post_atc_check(self, object_name, object_type, csrf_token):

        # ---------------------------------------------
        # Create XML body
        # ---------------------------------------------

        xml_body = f"""<?xml version="1.0" encoding="utf-8"?>
<osl:objectSet
    xsi:type="osl:flatObjectSet"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:osl="http://www.sap.com/api/osl">

    <osl:object name="{object_name}" type="{object_type}"/>

</osl:objectSet>
"""

        # ---------------------------------------------
        # ATC URL
        # ---------------------------------------------

        ATC_RUN_URL = (
            self.base_url
            + "/sap/bc/adt/api/atc/runs?clientWait=false"
        )

        # ---------------------------------------------
        # POST request
        # ---------------------------------------------

        response = self.session.post(
            ATC_RUN_URL,
            headers={
                "x-csrf-token": csrf_token,
                "Content-Type":
                    "application/vnd.sap.atc.run.parameters.v1+xml"
            },
            data=xml_body
        )

        response.raise_for_status()

        # ---------------------------------------------
        # Get Location header
        # ---------------------------------------------

        location = response.headers.get("Location")

        if not location:
            raise Exception(
                "ATC run started but Location header was not returned."
            )

        return location


    # =====================================================
    # 3. GET RUN STATUS
    # =====================================================

    def get_run_status(self, location):

        # Location returned by POST normally contains
        # the ATC run URL.

        if location.startswith("http"):
            RUN_URL = location
        else:
            RUN_URL = self.base_url + location

        response = self.session.get(
            RUN_URL,
            headers={
                "Accept":
                    "application/vnd.sap.atc.run.v1+xml"
            }
        )

        response.raise_for_status()

        return response.text


    # =====================================================
    # 4. GET ATC RESULTS
    # =====================================================

    def get_atc_results(self, location):

        # ---------------------------------------------
        # Extract UUID from Location
        # ---------------------------------------------

        uuid = location.rstrip("/").split("/")[-1]

        # ---------------------------------------------
        # Results URL
        # ---------------------------------------------

        RESULTS_URL = (
            self.base_url
            + "/sap/bc/adt/api/atc/results/"
            + uuid
        )

        # ---------------------------------------------
        # GET results
        # ---------------------------------------------

        response = self.session.get(
            RESULTS_URL,
            headers={
                "Accept":
                    "application/vnd.sap.atc.checkstyle.v1+xml"
            }
        )

        response.raise_for_status()

        return response.text


