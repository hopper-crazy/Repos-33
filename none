```javascript
/* =====================================================
   ELEMENTS
===================================================== */

const inputSection =
    document.getElementById("inputSection");

const processingSection =
    document.getElementById("processingSection");

const transportInput =
    document.getElementById("transport");

const reviewButton =
    document.getElementById("reviewButton");

const processingTransport =
    document.getElementById("processingTransport");

const processingStatus =
    document.getElementById("processingStatus");

const progressBar =
    document.getElementById("progressBar");

const processingPercent =
    document.getElementById("processingPercent");

const resultMessage =
    document.getElementById("resultMessage");



/* =====================================================
   START REVIEW
===================================================== */

async function startReview() {


    const transport =
        transportInput.value.trim();


    /* =========================================
       VALIDATION
    ========================================== */

    if (!transport) {

        showMessage(
            "Please enter a Transport Request."
        );

        transportInput.focus();

        return;
    }



    /* =========================================
       SHOW PROCESSING SCREEN
    ========================================== */

    inputSection.style.display = "none";

    processingSection.style.display = "block";

    processingTransport.innerText =
        transport;



    /* =========================================
       RESET PROCESSING UI
    ========================================== */

    processingStatus.innerText =
        "Connecting to SAP...";

    processingStatus.style.color =
        "#68717b";

    progressBar.style.width =
        "0%";

    processingPercent.innerText =
        "0%";



    /* =========================================
       PROCESSING ANIMATION
    ========================================== */

    const steps = [

        {
            text: "Connecting to SAP...",
            progress: 15
        },

        {
            text: "Retrieving transport objects...",
            progress: 30
        },

        {
            text: "Fetching ABAP source code...",
            progress: 50
        },

        {
            text: "Running ATC checks...",
            progress: 70
        },

        {
            text: "Analyzing code quality...",
            progress: 85
        },

        {
            text: "Preparing review results...",
            progress: 95
        }

    ];


    let currentStep = 0;


    /*
     * Change the status every 1.5 seconds.
     *
     * This continues while fetch()
     * is waiting for the backend.
     */

    const statusInterval =
        setInterval(() => {


            if (
                currentStep >=
                steps.length
            ) {

                return;

            }


            const step =
                steps[currentStep];


            /*
             * Fade current status out
             */

            processingStatus.style.opacity =
                "0";


            setTimeout(() => {


                processingStatus.innerText =
                    step.text;


                progressBar.style.width =
                    step.progress + "%";


                processingPercent.innerText =
                    step.progress + "%";


                processingStatus.style.opacity =
                    "1";


            }, 150);


            currentStep++;


        }, 1500);



    /* =========================================
       API CALL
    ========================================== */

    try {


        const response =
            await fetch(
                "http://localhost:8000/process_transport",
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body: JSON.stringify({

                        transport:
                            transport

                    })

                }
            );



        /* =====================================
           HTTP ERROR
        ====================================== */

        if (!response.ok) {

            throw new Error(
                `HTTP ${response.status}`
            );

        }



        /* =====================================
           GET JSON RESPONSE
        ====================================== */

        const data =
            await response.json();



        console.log(
            "API Response:",
            data
        );



        /* =====================================
           STOP PROCESSING ANIMATION
        ====================================== */

        clearInterval(
            statusInterval
        );


        progressBar.style.width =
            "100%";


        processingPercent.innerText =
            "100%";


        processingStatus.innerText =
            "Analysis complete";


        processingStatus.style.color =
            "#2f8f62";



        /* =====================================
           NEXT STEP
        ====================================== */

        setTimeout(() => {


            /*
             * Your API response is available here.
             *
             * Example response:
             *
             * [
             *     {
             *         object_name:
             *             "ZCL_ORDER_PROCESSOR",
             *
             *         object_type:
             *             "CLAS",
             *
             *         object_info:
             *             "ABAP Class",
             *
             *         object_desc:
             *             "Order processor",
             *
             *         atc_checks: [],
             *
             *         source_code:
             *             "CLASS..."
             *     }
             * ]
             */


            console.log(
                "Transport Review Data:",
                data
            );


            /*
             * NEXT:
             *
             * showReviewPage(data);
             *
             * We can create the complete
             * review page from this JSON.
             */


        }, 600);


    }


    /* =========================================
       API ERROR
    ========================================== */

    catch (error) {


        clearInterval(
            statusInterval
        );


        console.error(
            "API Error:",
            error
        );


        processingStatus.innerText =
            "Unable to complete the review";


        processingStatus.style.color =
            "#b45309";


        progressBar.style.width =
            "0%";


        processingPercent.innerText =
            "Error";



        /*
         * Return to input after 2.5 seconds
         */

        setTimeout(() => {


            processingSection.style.display =
                "none";


            inputSection.style.display =
                "block";


            processingStatus.style.color =
                "#68717b";


        }, 2500);

    }

}



/* =====================================================
   MESSAGE
===================================================== */

function showMessage(message) {

    resultMessage.style.display =
        "block";

    resultMessage.innerText =
        message;

}



/* =====================================================
   BUTTON EVENT
===================================================== */

reviewButton.addEventListener(
    "click",
    startReview
);



/* =====================================================
   ENTER KEY
===================================================== */

transportInput.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Enter") {

            startReview();

        }

    }
);
```
