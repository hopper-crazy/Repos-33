      IF s_specid[] IS NOT INITIAL.
        gv_filter = cl_shdb_seltab=>combine_seltabs(
          it_named_seltabs = VALUE #(
            ( name = 'SUBID' dref = REF #( s_specid[] ) ) ) ).
      ENDIF.

      zcl_plm_data_extract=>get_esh_data(
        EXPORTING
          iv_subcat       = p_subcat
          iv_subid_filter = gv_filter
        IMPORTING
          et_estrh        = gt_head ).

      IF gt_head IS INITIAL.
        MESSAGE 'No matching specifications found.' TYPE 'S'
          DISPLAY LIKE 'I'.
        RETURN.
      ENDIF.

      CASE p_sgmnt.
        WHEN '1'.
          zcl_plm_data_extract=>get_header(
            EXPORTING it_head = gt_head
            IMPORTING et_data = gt_header ).
          ASSIGN gt_header TO <gt_output>.
        WHEN '2'.
          zcl_plm_data_extract=>get_identifiers(
            EXPORTING it_head = gt_head
            IMPORTING et_data = gt_ident ).
          ASSIGN gt_ident TO <gt_output>.
        WHEN '3'.
          zcl_plm_data_extract=>get_materials(
            EXPORTING it_head = gt_head iv_subcat = p_subcat
            IMPORTING et_data = gt_mat ).
          ASSIGN gt_mat TO <gt_output>.
        WHEN '4'.
          " The class handles ZUT_RFC_DATA_EXT exactly ONCE.
          " Do not call the RFC again in this report.
          zcl_plm_data_extract=>get_vat(
            EXPORTING it_head = gt_head iv_langu = sy-langu
            IMPORTING et_data = gt_vat ).
          ASSIGN gt_vat TO <gt_output>.
        WHEN '5'.
          zcl_plm_data_extract=>get_composition(
            EXPORTING it_head = gt_head iv_langu = sy-langu
            IMPORTING et_data = gt_comp ).
          ASSIGN gt_comp TO <gt_output>.
        WHEN '6'.
          zcl_plm_data_extract=>get_inheritance(
            EXPORTING it_head = gt_head
            IMPORTING et_data = gt_inherit ).
          ASSIGN gt_inherit TO <gt_output>.
        WHEN OTHERS.
          MESSAGE 'Select a valid segment (1-6).' TYPE 'E'.
      ENDCASE.
