import requests


# ============================================================
# 1. GET CSRF TOKEN
# ============================================================

def get_csrf_token(base_url, cookies):

    url = (
        base_url
        + "/sap/bc/adt/discovery"
    )

    headers = {
        "x-csrf-token": "Fetch"
    }

    response = requests.get(
        url,
        headers=headers,
        cookies=cookies,
        verify=False
    )

    if response.status_code != 200:
        print(response.text)
        response.raise_for_status()

    csrf_token = response.headers.get(
        "x-csrf-token"
    )

    if not csrf_token:
        raise Exception(
            "CSRF token was not returned."
        )

    return csrf_token


# ============================================================
# 2. BUILD ATC XML
# ============================================================

def build_atc_xml(object_uri):

    xml = f'''<?xml version="1.0" encoding="UTF-8"?>

<atc:run
    xmlns:atc="http://www.sap.com/adt/atc"
    maximumViolations="100">

    <objectSets
        xmlns:adtcore="http://www.sap.com/adt/core">

        <objectSet kind="inclusive">

            <adtcore:objectReferences>

                <adtcore:objectReference
                    adtcore:uri="/{object_uri}"/>

            </adtcore:objectReferences>

        </objectSet>

    </objectSets>

</atc:run>
'''

    return xml


# ============================================================
# 3. START ATC CHECK
# ============================================================

def post_atc_check(
    base_url,
    cookies,
    csrf_token,
    object_uri
):

    url = (
        base_url
        + "/sap/bc/adt/atc/runs"
    )

    xml_body = build_atc_xml(
        object_uri
    )

    headers = {
        "x-csrf-token": csrf_token,
        "Content-Type": "application/xml",
        "Accept":
            "application/vnd.sap.atc.run.v1+xml"
    }

    response = requests.post(
        url,
        headers=headers,
        cookies=cookies,
        data=xml_body,
        verify=False
    )

    print(
        "ATC POST status:",
        response.status_code
    )

    if response.status_code not in [200, 201, 202]:

        print(response.text)

        raise Exception(
            f"ATC check failed: "
            f"{response.status_code}"
        )

    # SAP returns the ATC run location here
    location = response.headers.get(
        "Location"
    )

    if not location:

        raise Exception(
            "Location header not returned."
        )

    # Example:
    # /sap/bc/adt/atc/runs/XXXXXXXX
    run_id = location.rstrip(
        "/"
    ).split("/")[-1]

    print(
        "ATC Run ID:",
        run_id
    )

    return run_id


# ============================================================
# 4. GET ATC RESULTS
# ============================================================

def get_atc_results(
    base_url,
    cookies,
    run_id
):

    url = (
        base_url
        + "/sap/bc/adt/atc/runs/"
        + run_id
        + "/results"
    )

    headers = {
        "Accept":
            "application/vnd.sap.atc.result.v1+xml"
    }

    response = requests.get(
        url,
        headers=headers,
        cookies=cookies,
        verify=False
    )

    print(
        "ATC result status:",
        response.status_code
    )

    if response.status_code != 200:

        print(response.text)

        response.raise_for_status()

    return response.text


# ============================================================
# 5. COMPLETE ATC FLOW FOR ONE OBJECT
# ============================================================

def run_atc_for_object(
    base_url,
    cookies,
    object_uri
):

    # Step 1: Get CSRF
    csrf_token = get_csrf_token(
        base_url,
        cookies
    )

    # Step 2: Start ATC
    run_id = post_atc_check(
        base_url,
        cookies,
        csrf_token,
        object_uri
    )

    # Step 3: Get results
    results_xml = get_atc_results(
        base_url,
        cookies,
        run_id
    )

    return results_xml
