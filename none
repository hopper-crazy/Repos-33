import requests
import urllib3

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)


# ============================================================
# ADT SESSION CONFIGURATION
# ============================================================

def create_adt_session():

    session = requests.Session()

    # --------------------------------------------------------
    # Add your SAP cookies here
    # --------------------------------------------------------
    session.cookies.update({
        "SAP_SESSIONID_ABC_123": "YOUR_SESSION_COOKIE",
        "sap-usercontext": "sap-client=100"
    })

    # --------------------------------------------------------
    # Common headers
    # --------------------------------------------------------
    session.headers.update({
        "Accept": "text/plain",
        "User-Agent": "Mozilla/5.0"
    })

    session.verify = False

    return session


# ============================================================
# COMMON API METHOD
# ============================================================

def get_source_code(session, url):

    response = session.get(url)

    if response.status_code == 200:
        return response.text

    print(f"API failed - HTTP {response.status_code}")
    print(url)

    return None


# ============================================================
# 1. PROG - ABAP Executable Program / Report
# ============================================================

def get_program_source(session, base_url, program_name):

    url = (
        f"{base_url}/sap/bc/adt/programs/programs/"
        f"{program_name}/source/main"
    )

    return get_source_code(session, url)


