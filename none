from ADT_API import ADTAPI


# =====================================================
# SAP CONNECTION
# =====================================================

base_url = "https://your-sap-system"
username = "username"
password = "password"


adt = ADTAPI(
    base_url,
    username,
    password
)


# =====================================================
# OBJECT
# =====================================================

object_name = "CLASS1"
object_type = "CLAS"


# =====================================================
# 1. GET CSRF TOKEN
# =====================================================

csrf_token = adt.get_csrf_token()

print("CSRF Token received")


# =====================================================
# 2. POST ATC CHECK
# =====================================================

location = adt.post_atc_check(
    object_name,
    object_type,
    csrf_token
)

print("ATC Run started")
print("Location:", location)


# =====================================================
# 3. GET RUN STATUS
# =====================================================

while True:

    status = adt.get_run_status(location)

    print("ATC Status:")
    print(status)

    if "completed" in status.lower():
        break

    time.sleep(2)


# =====================================================
# 4. GET ATC RESULTS
# =====================================================

results = adt.get_atc_results(location)

print("\n========== ATC RESULTS ==========\n")
print(results)
