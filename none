from fastapi import FastAPI
from pydantic import BaseModel

import operations as op
import processor as pro


app = FastAPI()


class TransportRequest(BaseModel):
    transport: str


@app.post("/api/review/transport")
def review_transport(request: TransportRequest):

    # SAP server
    base_url = "https://ds5appe001.nccomickcorp.com:44300"

    # Create session with cookies and headers
    session = op.create_adt_session()

    # Get TR number from request
    tr_number = request.transport.strip()

    # Start the process
    result = pro.process_transport(
        session,
        base_url,
        tr_number
    )

    # Return JSON array
    return result
