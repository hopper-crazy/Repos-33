/* =========================================================
   INITIALIZE
========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function () {

        transportNumber.textContent =
            transportRequest || "Unknown";

        breadcrumbTR.textContent =
            transportRequest || "Unknown";

        objectCount.textContent =
            reviewData.length;

        renderObjectList();

        if (reviewData.length > 0) {

            selectObject(0);

        } else {

            showEmptyState();

        }

    }
);


/* =========================================================
   OBJECT TYPE DISPLAY
========================================================= */

function getObjectTypeName(type) {

    const types = {

        PROG: "Program",

        CLAS: "Class",

        INTF: "Interface",

        FUGR: "Function Group",

        FUNC: "Function Module",

        DDLS: "DDL Source",

        DCLS: "DCL Source",

        DDLX: "DDL Extension",

        BDEF: "Behavior Definition",

        SRVD: "Service Definition"

    };

    return types[type] || type || "Object";
}


/* =========================================================
   GET OBJECT STATUS
========================================================= */

function getObjectStatus(object) {

    const checks =
        Array.isArray(object.atc_checks)
            ? object.atc_checks
            : [];

    if (checks.length === 0) {

        return "success";

    }


    const hasError =
        checks.some(check =>
            String(check.severity || "")
                .toLowerCase()
                .includes("error")
        );

    if (hasError) {

        return "error";

    }

    return "warning";
}


/* =========================================================
   RENDER OBJECT LIST
========================================================= */

function renderObjectList() {

    objectList.innerHTML = "";

    reviewData.forEach(
        (object, index) => {

            const item =
                document.createElement("div");

            item.className = "object-item";

            if (index === currentObjectIndex) {

                item.classList.add("active");

            }


            const status =
                getObjectStatus(object);


            const atcChecks =
                Array.isArray(object.atc_checks)
                    ? object.atc_checks
                    : [];


            item.innerHTML = `

                <div class="object-status ${status}">
                </div>

                <div class="object-information">

                    <div class="object-name">
                        ${escapeHtml(
                            object.object_name || "Unnamed Object"
                        )}
                    </div>

                    <div class="object-meta">

                        <span class="object-type">
                            ${escapeHtml(
                                object.object_type || "—"
                            )}
                        </span>

                    </div>

                </div>

                <span class="finding-count">
                    ${atcChecks.length}
                </span>

            `;


            item.addEventListener(
                "click",
                function () {

                    selectObject(index);

                }
            );


            objectList.appendChild(item);

        }
    );

}


/* =========================================================
   SELECT OBJECT
========================================================= */

function selectObject(index) {

    if (!reviewData[index]) {

        return;

    }


    currentObjectIndex = index;


    const object =
        reviewData[index];


    /*
     * Update sidebar
     */

    document
        .querySelectorAll(".object-item")
        .forEach((item, i) => {

            item.classList.toggle(
                "active",
                i === index
            );

        });


    /*
     * Update object header
     */

    objectName.textContent =
        object.object_name || "Unnamed Object";


    objectDescription.textContent =
        object.object_desc ||
        object.object_info ||
        "No object description available.";


    objectTypeBadge.textContent =
        getObjectTypeName(
            object.object_type
        );


    breadcrumbType.textContent =
        object.object_type || "—";


    /*
     * ATC
     */

    const atcChecks =
        Array.isArray(object.atc_checks)
            ? object.atc_checks
            : [];


    atcCount.textContent =
        atcChecks.length;

    atcTabCount.textContent =
        atcChecks.length;


    /*
     * AI
     */

    const aiReviews =
        Array.isArray(object.ai_code_review)
            ? object.ai_code_review
            : [];


    aiCount.textContent =
        aiReviews.length;

    aiTabCount.textContent =
        aiReviews.length;


    /*
     * Source
     */

    renderSourceCode(
        object.source_code
    );


    /*
     * ATC findings
     */

    renderATCChecks(
        atcChecks
    );


    /*
     * AI review
     */

    renderAIReview(
        object
    );


    /*
     * IMPORTANT:
     *
     * Chatbot does NOT automatically open.
     *
     * If user changes object, chatbot remains closed.
     */

    chatbot.classList.remove("open");

}


/* =========================================================
   SOURCE CODE
========================================================= */

function renderSourceCode(code) {

    if (!code) {

        sourceCode.textContent =
            "// No source code available.";

        lineCount.textContent =
            "0 lines";

        return;

    }


    sourceCode.textContent = code;


    const lines =
        code.split("\n").length;


    lineCount.textContent =
        `${lines} lines`;


    codeFileName.textContent =
        reviewData[currentObjectIndex]
            ?.object_name || "source.abap";

}


/* =========================================================
   ATC FINDINGS
========================================================= */

function renderATCChecks(checks) {

    atcContainer.innerHTML = "";


    if (checks.length === 0) {

        atcContainer.innerHTML = `

            <div class="empty-state">

                <strong>
                    No ATC findings
                </strong>

                <br><br>

                This object passed the available
                automated checks.

            </div>

        `;

        return;

    }


    checks.forEach(check => {

        const severity =
            String(check.severity || "")
                .toLowerCase();


        let cardType = "info";

        let icon = "i";


        if (severity.includes("error")) {

            cardType = "error";

            icon = "!";

        } else if (
            severity.includes("warning")
        ) {

            cardType = "warning";

            icon = "!";

        }


        const card =
            document.createElement("div");


        card.className =
            `finding-card ${cardType}`;


        card.innerHTML = `

            <div class="finding-indicator">
                ${icon}
            </div>


            <div class="finding-body">

                <div class="finding-message">

                    ${escapeHtml(
                        check.message ||
                        "ATC finding"
                    )}

                </div>


                <div class="finding-source">

                    ${escapeHtml(
                        check.source ||
                        "SAP ATC"
                    )}

                </div>


                ${
                    check.recommendation
                    ?
                    `
                    <div class="finding-recommendation">

                        ${escapeHtml(
                            check.recommendation
                        )}

                    </div>
                    `
                    :
                    ""
                }

            </div>


            <span class="finding-severity">

                ${escapeHtml(
                    check.severity ||
                    "INFO"
                ).toUpperCase()}

            </span>

        `;


        atcContainer.appendChild(card);

    });

}


/* =========================================================
   AI REVIEW
========================================================= */

function renderAIReview(object) {

    const reviews =
        Array.isArray(object.ai_code_review)
            ? object.ai_code_review
            : [];


    renderOverallAssessment(
        object.ai_overall_assessment
    );


    aiContainer.innerHTML = "";


    if (reviews.length === 0) {

        aiContainer.innerHTML = `

            <div class="empty-state">

                No AI findings available for this object.

            </div>

        `;

        return;

    }


    reviews.forEach(review => {

        const card =
            document.createElement("div");


        card.className =
            "ai-card";


        const severity =
            String(review.severity || "")
                .toLowerCase();


        card.innerHTML = `

            <div class="ai-card-header">

                <div class="ai-category">

                    <span>
                        ✦
                    </span>

                    ${escapeHtml(
                        review.category ||
                        "Code Quality"
                    )}

                </div>


                <span class="ai-severity">

                    ${escapeHtml(
                        review.severity ||
                        "INFO"
                    ).toUpperCase()}

                </span>

            </div>


            ${
                review.findings
                ?
                `
                <div class="ai-comment">

                    <strong>Finding:</strong><br>

                    ${escapeHtml(
                        review.findings
                    )}

                </div>
                `
                :
                ""
            }


            ${
                review.comment
                ?
                `
                <div class="ai-comment">

                    ${escapeHtml(
                        review.comment
                    )}

                </div>
                `
                :
                ""
            }


            ${
                review.recommendation
                ?
                `
                <div class="ai-recommendation">

                    <strong>
                        Recommendation
                    </strong>

                    <br><br>

                    ${escapeHtml(
                        review.recommendation
                    )}

                </div>
                `
                :
                ""
            }


            ${
                review.code_reference
                ?
                `
                <div class="code-reference">

                    ${escapeHtml(
                        review.code_reference
                    )}

                </div>
                `
                :
                ""
            }

        `;


        aiContainer.appendChild(card);

    });

}


/* =========================================================
   OVERALL AI ASSESSMENT
========================================================= */

function renderOverallAssessment(
    assessment
) {

    if (!assessment) {

        assessmentCard.innerHTML = `

            <div class="assessment-summary">

                No overall AI assessment available.

            </div>

        `;

        return;

    }


    const status =
        String(
            assessment.status || ""
        ).toLowerCase();


    let statusClass = "review";


    if (
        status.includes("pass") ||
        status.includes("good") ||
        status.includes("clean") ||
        status.includes("success")
    ) {

        statusClass = "good";

    } else if (
        status.includes("fail") ||
        status.includes("critical") ||
        status.includes("error")
    ) {

        statusClass = "critical";

    }


    assessmentCard.innerHTML = `

        <div class="assessment-top">

            <span class="assessment-status ${statusClass}">

                ${escapeHtml(
                    assessment.status ||
                    "REVIEW"
                ).toUpperCase()}

            </span>


            <span class="assessment-title">

                Overall Assessment

            </span>

        </div>


        <div class="assessment-summary">

            ${escapeHtml(
                assessment.Summary ||
                assessment.summary ||
                "No summary available."
            )}

        </div>

    `;

}


/* =========================================================
   TABS
========================================================= */

document
    .querySelectorAll(".tab")
    .forEach(tab => {

        tab.addEventListener(
            "click",
            function () {

                const selectedTab =
                    this.dataset.tab;


                /*
                 * Remove active from buttons
                 */

                document
                    .querySelectorAll(".tab")
                    .forEach(t =>
                        t.classList.remove("active")
                    );


                this.classList.add("active");


                /*
                 * Hide all content
                 */

                document
                    .querySelectorAll(".tab-content")
                    .forEach(content => {

                        content.classList.remove(
                            "active-tab-content"
                        );

                    });


                /*
                 * Show selected
                 */

                const content =
                    document.getElementById(
                        selectedTab + "Tab"
                    );


                if (content) {

                    content.classList.add(
                        "active-tab-content"
                    );

                }

            }
        );

    });


/* =========================================================
   CHATBOT
========================================================= */


/*
 * IMPORTANT:
 *
 * Chatbot only opens when user clicks
 * the object itself.
 *
 * We add a small chat action when
 * hovering/clicking the object.
 */


/*
 * Instead of opening automatically when
 * selecting an object, we'll provide
 * a keyboard/mouse interaction.
 *
 * Double-click an object to open chatbot.
 */

objectList.addEventListener(
    "dblclick",
    function (event) {

        const objectItem =
            event.target.closest(".object-item");


        if (!objectItem) {

            return;

        }


        const items =
            Array.from(
                document.querySelectorAll(
                    ".object-item"
                )
            );


        const index =
            items.indexOf(objectItem);


        if (index >= 0) {

            selectObject(index);

            openChat();

        }

    }
);


/*
 * Open chatbot
 */

function openChat() {

    chatbot.classList.add("open");

    chatInput.focus();

}


/*
 * Close chatbot
 */

closeChat.addEventListener(
    "click",
    function () {

        chatbot.classList.remove("open");

    }
);


/*
 * Submit chatbot
 *
 * For now this intentionally does nothing
 * except display the user's message.
 *
 * Later you can replace this with:
 *
 * fetch("/chat", {...})
 */

chatSubmit.addEventListener(
    "click",
    submitChat
);


chatInput.addEventListener(
    "keydown",
    function (event) {

        if (event.key === "Enter") {

            submitChat();

        }

    }
);


function submitChat() {

    const message =
        chatInput.value.trim();


    if (!message) {

        return;

    }


    /*
     * Display user message
     */

    const userMessage =
        document.createElement("div");


    userMessage.style.cssText = `
        display:block;
        width:fit-content;
        max-width:85%;
        margin:8px 0 8px auto;
        background:#303941;
        color:#ffffff;
        padding:9px 11px;
        border-radius:8px;
        font-size:10px;
        line-height:1.5;
    `;


    userMessage.textContent =
        message;


    chatMessages.appendChild(
        userMessage
    );


    chatInput.value = "";


    /*
     * BOT METHOD INTENTIONALLY EMPTY
     *
     * Later:
     *
     * fetch("/chat", {
     *     method: "POST",
     *     headers: {
     *         "Content-Type": "application/json"
     *     },
     *     body: JSON.stringify({
     *         object_name:
     *             reviewData[currentObjectIndex]
     *                 .object_name,
     *         message: message
     *     })
     * })
     *
     */


    chatMessages.scrollTop =
        chatMessages.scrollHeight;

}


