CONSTANTS:
  gc_records_per_file TYPE i VALUE 500000.

DATA:
  gv_total_records TYPE i,
  gv_start         TYPE i VALUE 1,
  gv_end           TYPE i,
  gv_file_number   TYPE i VALUE 1,
  gv_filename      TYPE string,
  gv_file_number_c TYPE n LENGTH 3,
  gt_file_data     TYPE STANDARD TABLE OF ty_output.

gv_total_records = lines( gt_data ).

WHILE gv_start <= gv_total_records.

  "Calculate the end index for the current file
  gv_end = gv_start + gc_records_per_file - 1.

  IF gv_end > gv_total_records.
    gv_end = gv_total_records.
  ENDIF.

  "Prepare current chunk
  CLEAR gt_file_data.

  APPEND LINES OF gt_data
    FROM gv_start
    TO gv_end
    TO gt_file_data.

  "Build filename
  gv_file_number_c = gv_file_number.

  gv_filename = |C:\Temp\OUTPUT_{ gv_file_number_c }.csv|.

  "Download current chunk
  CALL FUNCTION 'GUI_DOWNLOAD'
    EXPORTING
      filename              = gv_filename
      filetype              = 'ASC'
      write_field_separator = abap_true
    TABLES
      data_tab              = gt_file_data
    EXCEPTIONS
      file_write_error      = 1
      no_batch              = 2
      gui_refuse_filetransfer = 3
      OTHERS                = 4.

  IF sy-subrc <> 0.
    MESSAGE 'Error downloading output file' TYPE 'E'.
  ENDIF.

  "Move to next chunk
  gv_start       = gv_end + 1.
  gv_file_number = gv_file_number + 1.

ENDWHILE.
