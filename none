async function checkSAPConnection() {

    const connectionDot = document.getElementById("connectionDot");
    const connectionText = document.getElementById("connectionText");

    // Initially show checking state
    connectionDot.classList.remove("connected", "disconnected");
    connectionDot.classList.add("checking");

    connectionText.textContent = "Checking SAP...";

    try {

        const response = await fetch(
            "http://localhost:8000/check_connection"
        );

        if (!response.ok) {
            throw new Error("SAP connection failed");
        }

        // SAP is connected
        connectionDot.classList.remove("checking", "disconnected");
        connectionDot.classList.add("connected");

        connectionText.textContent = "SAP Connected";

    } catch (error) {

        // SAP is disconnected
        connectionDot.classList.remove("checking", "connected");
        connectionDot.classList.add("disconnected");

        connectionText.textContent = "SAP Disconnected";

        console.error("SAP connection error:", error);
    }
}

<div class="connection">

    <span id="connectionDot" class="status-dot checking"></span>

    <span id="connectionText">
        Checking SAP...
    </span>

</div>



.status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
}

.status-dot.connected {
    background: #16a34a;
}

.status-dot.disconnected {
    background: #dc2626;
}

.status-dot.checking {
    background: #f59e0b;
    animation: connectionPulse 1.2s infinite;
}

@keyframes connectionPulse {
    0%, 100% {
        opacity: 1;
    }

    50% {
        opacity: 0.35;
    }
}
