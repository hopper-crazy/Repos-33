
REPORT zplm_excel_download.

*--------------------------------------------------------------------*
* Field mapping - shared across all six tables
*--------------------------------------------------------------------*
TYPES: BEGIN OF ty_column,
         fieldname TYPE fieldname,
         header    TYPE string,
         position  TYPE i,
         width     TYPE i,
       END OF ty_column.

TYPES tt_columns TYPE STANDARD TABLE OF ty_column
                 WITH DEFAULT KEY.

*--------------------------------------------------------------------*
* Global Excel objects
*--------------------------------------------------------------------*
DATA: go_excel       TYPE REF TO zcl_excel,
      go_sheet       TYPE REF TO zcl_excel_worksheet,
      gv_sheet_count TYPE i.

DATA: gv_header_style TYPE zexcel_cell_style,
      gv_normal_style TYPE zexcel_cell_style,
      gv_alt_style    TYPE zexcel_cell_style.

DATA: gt_columns TYPE tt_columns.

START-OF-SELECTION.

  CREATE OBJECT go_excel.

  PERFORM create_styles.

*--------------------------------------------------------------------*
* Example 1 - ESTRH header extraction
* Replace this sample table with your actual extraction table
*--------------------------------------------------------------------*
  TYPES: BEGIN OF ty_head,
           recn   TYPE estrh-recn,
           subid  TYPE estrh-subid,
           subcat TYPE estrh-subcat,
           crdat  TYPE estrh-crdat,
           upddat TYPE estrh-upddat,
         END OF ty_head.

  DATA: lt_head TYPE STANDARD TABLE OF ty_head.

  " Here you would populate LT_HEAD using your PLM logic.

  CLEAR gt_columns.

  APPEND VALUE #(
    fieldname = 'RECN'
    header    = 'Specification Number'
    position  = 1
    width     = 24 ) TO gt_columns.

  APPEND VALUE #(
    fieldname = 'SUBID'
    header    = 'Specification ID'
    position  = 2
    width     = 26 ) TO gt_columns.

  APPEND VALUE #(
    fieldname = 'SUBCAT'
    header    = 'Specification Category'
    position  = 3
    width     = 28 ) TO gt_columns.

  APPEND VALUE #(
    fieldname = 'CRDAT'
    header    = 'Created On'
    position  = 4
    width     = 18 ) TO gt_columns.

  APPEND VALUE #(
    fieldname = 'UPDDAT'
    header    = 'Changed On'
    position  = 5
    width     = 18 ) TO gt_columns.

  PERFORM add_excel_sheet
    USING 'Specification Header'
          lt_head
          gt_columns.

*--------------------------------------------------------------------*
* Example 2 - Material assignments (ESTMJ)
*--------------------------------------------------------------------*
  TYPES: BEGIN OF ty_mat,
           recnroot TYPE estmj-recnroot,
           matnr    TYPE estmj-matnr,
         END OF ty_mat.

  DATA: lt_material TYPE STANDARD TABLE OF ty_mat.

  " Populate LT_MATERIAL using existing extraction logic.

  CLEAR gt_columns.

  APPEND VALUE #(
    fieldname = 'RECNROOT'
    header    = 'Specification Number'
    position  = 1
    width     = 25 ) TO gt_columns.

  APPEND VALUE #(
    fieldname = 'MATNR'
    header    = 'Material Number'
    position  = 2
    width     = 25 ) TO gt_columns.

  PERFORM add_excel_sheet
    USING 'Material Assignments'
          lt_material
          gt_columns.

*--------------------------------------------------------------------*
* Add the other four extraction tables in the same manner.
*--------------------------------------------------------------------*

  PERFORM download_excel.

*--------------------------------------------------------------------*
* FORM CREATE_STYLES
*--------------------------------------------------------------------*
FORM create_styles.

  DATA: lo_style  TYPE REF TO zcl_excel_style,
        lo_border TYPE REF TO zcl_excel_style_border.

  CREATE OBJECT lo_border.

  lo_border->border_style =
    zcl_excel_style_border=>c_border_thin.

  lo_border->border_color-rgb = 'D9E2F3'.

  " Header style
  lo_style = go_excel->add_new_style( ).

  lo_style->fill->filltype =
    zcl_excel_style_fill=>c_fill_solid.

  lo_style->fill->fgcolor-rgb = '17365D'.

  lo_style->font->bold = abap_true.
  lo_style->font->color-rgb = 'FFFFFF'.
  lo_style->font->size = 11.

  lo_style->alignment->horizontal =
    zcl_excel_style_alignment=>c_horizontal_center.

  lo_style->alignment->vertical =
    zcl_excel_style_alignment=>c_vertical_center.

  lo_style->borders->allborders = lo_border.

  gv_header_style = lo_style->get_guid( ).

  " Normal row style
  lo_style = go_excel->add_new_style( ).

  lo_style->borders->allborders = lo_border.

  gv_normal_style = lo_style->get_guid( ).

  " Alternating row style
  lo_style = go_excel->add_new_style( ).

  lo_style->fill->filltype =
    zcl_excel_style_fill=>c_fill_solid.

  lo_style->fill->fgcolor-rgb = 'EFF4FA'.

  lo_style->borders->allborders = lo_border.

  gv_alt_style = lo_style->get_guid( ).

ENDFORM.

*--------------------------------------------------------------------*
* FORM ADD_EXCEL_SHEET
* Works with any internal table containing structured rows.
*--------------------------------------------------------------------*
FORM add_excel_sheet
  USING iv_sheet_name TYPE string
        it_data       TYPE ANY TABLE
        it_columns    TYPE tt_columns.

  DATA: lt_columns TYPE tt_columns,
        ls_column  TYPE ty_column,
        lv_row     TYPE i,
        lv_style   TYPE zexcel_cell_style,
        lv_width   TYPE i.

  FIELD-SYMBOLS:
    <ls_data> TYPE any,
    <lv_value> TYPE any.

  " First worksheet is automatically created by ZCL_EXCEL.
  IF gv_sheet_count = 0.

    go_sheet = go_excel->get_active_worksheet( ).

  ELSE.

    go_sheet = go_excel->add_new_worksheet( ).

  ENDIF.

  gv_sheet_count = gv_sheet_count + 1.

  go_sheet->set_title(
    ip_title = iv_sheet_name
  ).

  " Sort mapping by requested Excel position.
  lt_columns = it_columns.

  SORT lt_columns BY position.

*--------------------------------------------------------------------*
* Write custom headers and set column widths
*--------------------------------------------------------------------*
  LOOP AT lt_columns INTO ls_column.

    IF ls_column-position <= 0.
      MESSAGE 'Invalid Excel column position' TYPE 'E'.
    ENDIF.

    go_sheet->set_cell(
      ip_column = ls_column-position
      ip_row    = 1
      ip_value  = ls_column-header
      ip_style  = gv_header_style
    ).

    lv_width = ls_column-width.

    IF lv_width <= 0.
      lv_width = 22.
    ENDIF.

    go_sheet->set_column_width(
      ip_column         = ls_column-position
      ip_width_fix      = lv_width
      ip_width_autosize = abap_false
    ).

  ENDLOOP.

  go_sheet->set_row_height(
    ip_row        = 1
    ip_height_fix = 30
  ).

*--------------------------------------------------------------------*
* Write all rows dynamically
*--------------------------------------------------------------------*
  lv_row = 2.

  LOOP AT it_data ASSIGNING <ls_data>.

    IF lv_row MOD 2 = 0.
      lv_style = gv_normal_style.
    ELSE.
      lv_style = gv_alt_style.
    ENDIF.

    LOOP AT lt_columns INTO ls_column.

      UNASSIGN <lv_value>.

      ASSIGN COMPONENT ls_column-fieldname
        OF STRUCTURE <ls_data>
        TO <lv_value>.

      IF sy-subrc <> 0.
        MESSAGE |Field { ls_column-fieldname } not found|
          TYPE 'E'.
      ENDIF.

      go_sheet->set_cell(
        ip_column = ls_column-position
        ip_row    = lv_row
        ip_value  = <lv_value>
        ip_style  = lv_style
      ).

    ENDLOOP.

    lv_row = lv_row + 1.

  ENDLOOP.

ENDFORM.

*--------------------------------------------------------------------*
* FORM DOWNLOAD_EXCEL
*--------------------------------------------------------------------*
FORM download_excel.

  DATA: lo_writer    TYPE REF TO zif_excel_writer,
        lv_xstring   TYPE xstring,
        lt_binary    TYPE solix_tab,
        lv_filename  TYPE string.

  CREATE OBJECT lo_writer TYPE zcl_excel_writer_2007.

  lv_xstring = lo_writer->write_file( go_excel ).

  lt_binary = cl_bcs_convert=>xstring_to_solix(
    iv_xstring = lv_xstring
  ).

  lv_filename = 'C:\Temp\PLM_Extraction.xlsx'.

  cl_gui_frontend_services=>gui_download(
    EXPORTING
      filename     = lv_filename
      filetype     = 'BIN'
      bin_filesize = xstrlen( lv_xstring )
    CHANGING
      data_tab     = lt_binary
    EXCEPTIONS
      OTHERS       = 1
  ).

  IF sy-subrc = 0.
    MESSAGE 'PLM Excel downloaded successfully'
      TYPE 'S'.
  ELSE.
    MESSAGE 'Error downloading Excel file'
      TYPE 'E'.
  ENDIF.

ENDFORM.
