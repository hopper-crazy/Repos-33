/* =========================================================
   LOAD DATA FROM SESSION STORAGE
========================================================= */

let reviewData = [];
let transportRequest = "";

try {

    reviewData = JSON.parse(
        sessionStorage.getItem("reviewData")
    ) || [];

    transportRequest =
        sessionStorage.getItem("transportRequest") || "";

} catch (error) {

    console.error("Unable to read review data:", error);

}


/* =========================================================
   CURRENT OBJECT
========================================================= */

let currentObjectIndex = 0;


/* =========================================================
   DOM ELEMENTS
========================================================= */

const objectList =
    document.getElementById("objectList");

const objectCount =
    document.getElementById("objectCount");

const transportNumber =
    document.getElementById("transportNumber");

const breadcrumbTR =
    document.getElementById("breadcrumbTR");

const breadcrumbType =
    document.getElementById("breadcrumbType");

const objectName =
    document.getElementById("objectName");

const objectDescription =
    document.getElementById("objectDescription");

const objectTypeBadge =
    document.getElementById("objectTypeBadge");

const atcCount =
    document.getElementById("atcCount");

const aiCount =
    document.getElementById("aiCount");

const atcTabCount =
    document.getElementById("atcTabCount");

const aiTabCount =
