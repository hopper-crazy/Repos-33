# MAIN
# ============================================================

def main():

    base_url = "https://your-sap-server:44300"

    session = create_adt_session()

    # --------------------------------------------------------
    # Examples
    # --------------------------------------------------------

    program_code = get_program_source(
        session,
        base_url,
        "ZMY_PROGRAM"
    )

