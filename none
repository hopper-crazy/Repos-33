<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SAP Code Review</title>

    <link rel="stylesheet" href="review.css">
</head>

<body>

    <!-- =====================================================
         TOP HEADER
    ====================================================== -->

    <header class="top-header">

        <div class="brand-section">

            <div class="brand-mark">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <div>
                <div class="brand-title">
                    SAP CODE REVIEW
                </div>

                <div class="brand-subtitle">
                    Intelligent ABAP Quality Platform
                </div>
            </div>

        </div>


        <div class="header-right">

            <div class="connection-status">

                <span id="connectionDot"
                      class="connection-dot connected">
                </span>

                <span id="connectionText">
                    SAP Connected
                </span>

            </div>

        </div>

    </header>


    <!-- =====================================================
         APPLICATION
    ====================================================== -->

    <div class="app-layout">


        <!-- =================================================
             SIDEBAR
        ================================================== -->

        <aside class="sidebar">


            <div class="sidebar-top">

                <div class="section-label">
                    TRANSPORT REQUEST
                </div>


                <div class="transport-card">

                    <div class="transport-icon">
                        ↗
                    </div>

                    <div>

                        <div class="transport-number"
                             id="transportNumber">
                            —
                        </div>

                        <div class="transport-label">
                            Code Review
                        </div>

                    </div>

                </div>


                <div class="objects-header">

                    <span>
                        OBJECTS
                    </span>

                    <span id="objectCount">
                        0
                    </span>

                </div>


                <div id="objectList"
                     class="object-list">

                    <!-- Objects generated by JS -->

                </div>

            </div>


            <!-- =================================================
                 SIDEBAR BOTTOM
            ================================================== -->

            <div class="sidebar-bottom">

                <button id="newReviewBtn"
                        class="new-review-button">

                    <span class="plus-icon">
                        +
                    </span>

                    <span>
                        New Review
                    </span>

                </button>

            </div>

        </aside>


        <!-- =================================================
             MAIN CONTENT
        ================================================== -->

        <main class="main-content">


            <!-- ================= OBJECT HEADER ================= -->

            <section class="object-header">

                <div>

                    <div class="breadcrumb">

                        <span>Transport</span>

                        <span class="breadcrumb-arrow">
                            /
                        </span>

                        <span id="breadcrumbTR">
                            —
                        </span>

                        <span class="breadcrumb-arrow">
                            /
                        </span>

                        <span id="breadcrumbType">
                            —
                        </span>

                    </div>


                    <div class="object-title-row">

                        <div>

                            <h1 id="objectName">
                                Select an object
                            </h1>

                            <p id="objectDescription">
                                Select an object from the transport request.
                            </p>

                        </div>


                        <div id="objectTypeBadge"
                             class="object-type-badge">
                            —
                        </div>

                    </div>

                </div>


                <!-- Object statistics -->

                <div class="object-summary">

                    <div class="summary-item">

                        <span class="summary-number"
                              id="atcCount">
                            0
                        </span>

                        <span class="summary-label">
                            ATC Findings
                        </span>

                    </div>


                    <div class="summary-divider"></div>


                    <div class="summary-item">

                        <span class="summary-number"
                              id="aiCount">
                            0
                        </span>

                        <span class="summary-label">
                            AI Findings
                        </span>

                    </div>

                </div>

            </section>


            <!-- ================= TABS ================= -->

            <div class="tabs">

                <button class="tab active"
                        data-tab="source">

                    Source Code

                </button>


                <button class="tab"
                        data-tab="atc">

                    ATC Findings

                    <span id="atcTabCount"
                          class="tab-count">
                        0
                    </span>

                </button>


                <button class="tab"
                        data-tab="ai">

                    AI Review

                    <span id="aiTabCount"
                          class="tab-count ai-count">
                        0
                    </span>

                </button>

            </div>


            <!-- =================================================
                 SOURCE TAB
            ================================================== -->

            <section id="sourceTab"
                     class="tab-content active-tab-content">


                <div class="section-heading">

                    <div>

                        <div class="section-title">
                            SOURCE CODE
                        </div>

                        <div class="section-subtitle">
                            ABAP implementation retrieved from SAP
                        </div>

                    </div>


                    <div id="lineCount"
                         class="line-count">
                        0 lines
                    </div>

                </div>


                <div class="code-editor">


                    <div class="editor-header">

                        <div class="editor-file">

                            <span class="file-dot"></span>

                            <span id="codeFileName">
                                source.abap
                            </span>

                        </div>


                        <span class="editor-language">
                            ABAP
                        </span>

                    </div>


                    <div class="code-container">

                        <pre id="sourceCode"></pre>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 ATC TAB
            ================================================== -->

            <section id="atcTab"
                     class="tab-content">

                <div class="section-heading">

                    <div>

                        <div class="section-title">
                            ATC FINDINGS
                        </div>

                        <div class="section-subtitle">
                            Automated Transport Check results
                        </div>

                    </div>

                </div>


                <div id="atcContainer"
                     class="findings-container">

                    <!-- ATC generated by JS -->

                </div>

            </section>


            <!-- =================================================
                 AI TAB
            ================================================== -->

            <section id="aiTab"
                     class="tab-content">


                <!-- Overall Assessment -->

                <div class="section-heading">

                    <div>

                        <div class="section-title">
                            AI CODE REVIEW
                        </div>

                        <div class="section-subtitle">
                            Intelligent analysis of the ABAP implementation
                        </div>

                    </div>

                    <div class="ai-label">
                        AI ANALYSIS
                    </div>

                </div>


                <div id="assessmentCard"
                     class="assessment-card">

                    <!-- generated by JS -->

                </div>


                <div id="aiContainer"
                     class="ai-findings-container">

                    <!-- AI findings generated by JS -->

                </div>

            </section>


        </main>

    </div>


    <!-- =====================================================
         CHATBOT
    ====================================================== -->

    <div id="chatbot"
         class="chatbot">


        <div class="chatbot-header">

            <div class="chatbot-title">

                <div class="bot-icon">
                    ✦
                </div>

                <div>

                    <strong>
                        Code Assistant
                    </strong>

                    <small>
                        Ask about this object
                    </small>

                </div>

            </div>


            <button id="closeChat"
                    class="close-chat">
                ×
            </button>

        </div>


        <div id="chatMessages"
             class="chat-messages">

            <div class="bot-message">

                I'm ready to help you understand this
                ABAP object.

                <br><br>

                Ask me about the source code, ATC findings,
                or AI recommendations.

            </div>

        </div>


        <div class="chat-input-area">

            <input id="chatInput"
                   type="text"
                   placeholder="Ask about this object...">

            <button id="chatSubmit">
                →
            </button>

        </div>

    </div>


    <script src="review.js"></script>

</body>

</html>
