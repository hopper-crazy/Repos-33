import requests
import urllib3

# Disable SSL certificate warnings
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)


# --------------------------------------------------
# Create SAP ADT Session
# --------------------------------------------------
def create_adt_session():

    session = requests.Session()

    # SAP cookies
    session.cookies.update({
        "SAP_SESSIONID_ABC_123": "YOUR_SESSION_COOKIE_VALUE",
        "sap-usercontext": "sap-client=100"
    })

    # Common headers
    session.headers.update({
        "Accept": "text/plain",
        "User-Agent": "Mozilla/5.0"
    })

    # Use False only if your SAP server has
    # an SSL certificate that Python cannot verify
    session.verify = False

    return session


# --------------------------------------------------
# Get ABAP Program Source Code
# --------------------------------------------------
def get_program_source(session, base_url, program_name):

    url = (
        f"{base_url}/sap/bc/adt/repository/"
        f"abapsource/programs/{program_name}/source/main"
    )

    response = session.get(url)

    if response.status_code == 200:
        return response.text

    print(f"API failed: {response.status_code}")
    print(response.text)

    return None


# --------------------------------------------------
# Main Program
# --------------------------------------------------
def main():

    # SAP ADT server
    base_url = "https://your-sap-server:44300"

    # Create session with cookies and headers
    session = create_adt_session()

    # ABAP program
    program_name = "ZMY_PROGRAM"

    # Get source code
    source_code = get_program_source(
        session,
        base_url,
        program_name
    )

    # Only process code if API returned 200
    if source_code is not None:
        print("Program source code:")
        print("--------------------------------")
        print(source_code)


if __name__ == "__main__":
    main()
