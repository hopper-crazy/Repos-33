CONSTANTS:
  lc_wricef     TYPE char10 VALUE 'R2R/E0118', " WRICEF Name
  lc_group_app  TYPE char3  VALUE 'M2',        " Application Server group
  lc_group_prs  TYPE char3  VALUE 'M3',        " Presentation Server group
  lc_group_down TYPE char3  VALUE 'M4'.        " Download-only group

" Determine which screen group should be disabled
DATA(lv_disable_group) = COND char3(
                           WHEN p_rapps  = abap_true THEN lc_group_prs
                           WHEN p_rpres  = abap_true THEN lc_group_app
                           ELSE space ).

"---------------------------------------------------------------
" Disable alternate path selection
" - If Application Server is selected → disable Presentation path
" - If Presentation Server is selected → disable Application path
"---------------------------------------------------------------
IF lv_disable_group IS NOT INITIAL.
  LOOP AT SCREEN.
    IF screen-group1 = lv_disable_group.
      screen-active = 0.
      CLEAR:
        p_pres,
        p_apps.
      MODIFY SCREEN.
    ENDIF.
  ENDLOOP.
ENDIF.

"---------------------------------------------------------------
" Download mode:
" - Enable only download-related fields
" - Disable all other input fields
"---------------------------------------------------------------
IF p_down IS NOT INITIAL.
  LOOP AT SCREEN.
    IF screen-group1 <> lc_group_down.
      screen-input = 0.
      CLEAR:
        p_pres,
        p_apps,
        p_newko,
        p_email,
        p_test.
      MODIFY SCREEN.
    ENDIF.
  ENDLOOP.
ENDIF.

--------------------------------------------------------------------------------------------------------------------------------------------

"---------------------------------------------------------------
" Upload file based on selected execution mode
"---------------------------------------------------------------
IF p_rapps = abap_true.

  " Application Server upload
  IF p_apps IS INITIAL.
    MESSAGE e000 WITH TEXT-009.
  ENDIF.

  PERFORM sub_data_apps CHANGING lv_xstring.

ELSEIF p_rpres = abap_true.

  " Presentation Server upload not allowed in background
  IF sy-batch = abap_true.
    MESSAGE e000 WITH TEXT-026.
  ENDIF.

  " Presentation Server file path mandatory
  IF p_pres IS INITIAL.
    MESSAGE e000 WITH TEXT-010.
  ENDIF.

  PERFORM sub_data_pres CHANGING lv_xstring.

ENDIF.

