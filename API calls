*&---------------------------------------------------------------------*
*&      Form  SUB_FILL_ITEM
*&---------------------------------------------------------------------*
*&      Fills GL item, currency amounts, and CO-PA criteria
*&      Handles both split and non-split posting scenarios
*&---------------------------------------------------------------------*
FORM sub_fill_item
  USING    us_ls_data        TYPE gy_data
           uv_itemno         TYPE posnr_acc
           cv_waers          TYPE waers
           cv_kursf          TYPE kursf
           cv_kursf_v        TYPE acpi_ukursm
           uv_split          TYPE xfeld
           ut_tvarvc         TYPE gy_t_tvarvc
           uv_journal_id     TYPE char16
           ut_skb1           TYPE gy_t_skb1
           us_documentheader TYPE bapiache09
           ut_t001           TYPE gy_t_t001
  CHANGING ct_lt_accountgl   TYPE bapiacgl09_tab
           ct_lt_curramt     TYPE bapiaccr09_tab
           cv_total_amount   TYPE bapiwrbtr
           ct_criteria       TYPE bapiackec9_tab
           ct_return_tmp     TYPE gy_t_bapiret.

  "--------------------------------------------------------------------*
  " Local Constants
  "--------------------------------------------------------------------*
  CONSTANTS:
    lc_debit       TYPE bschl      VALUE '40',                  "Debit posting key
    lc_vkorg       TYPE rvari_vnam VALUE 'ZR2R_E0118_VKORG',
    lc_vtweg       TYPE rvari_vnam VALUE 'ZR2R_E0118_VTWEG',
    lc_spart       TYPE rvari_vnam VALUE 'ZR2R_E0118_SPART',
    lc_kndnr       TYPE rvari_vnam VALUE 'ZR2R_E0118_KNDNR',
    lc_werks       TYPE rvari_vnam VALUE 'ZR2R_E0118_WERKS',
    lc_curr_typ_10 TYPE curtp      VALUE '10'.                  "Document currency

  "--------------------------------------------------------------------*
  " Local Data Declarations
  "--------------------------------------------------------------------*
  DATA:
    ls_accountgl TYPE bapiacgl09,
    ls_curramt   TYPE bapiaccr09,
    ls_criteria  TYPE bapiackec9,
    ls_tvarvc    TYPE gy_tvarvc,
    lv_linecount TYPE i,
    lv_amount_10 TYPE bapidoccur.

  "--------------------------------------------------------------------*
  " Split Posting Logic
  "--------------------------------------------------------------------*
  IF uv_split = abap_true.

    lv_linecount = lines( ct_lt_accountgl ).
    READ TABLE ct_lt_accountgl INTO ls_accountgl INDEX lv_linecount.

    IF sy-subrc = 0.

      " Update GL item for split
      ls_accountgl-itemno_acc = uv_itemno.
      ls_accountgl-gl_account = |{ p_newko ALPHA = IN }|.

      " Reverse amount for split posting
      ls_curramt-amt_doccur = cv_total_amount * -1.

      " Clear total amount after split
      CLEAR cv_total_amount.

      " Clear fields no longer relevant after split
      CLEAR:
        ls_accountgl-bus_area,
        ls_accountgl-costcenter,
        ls_accountgl-profit_ctr,
        ls_accountgl-plant,
        ls_accountgl-material,
        ls_accountgl-quantity,
        ls_accountgl-base_uom.

      " Append updated GL line
      APPEND ls_accountgl TO ct_lt_accountgl.

      " Currency amount (document currency)
      lv_amount_10 = ls_curramt-amt_doccur.

      ct_lt_curramt = VALUE #(
        BASE ct_lt_curramt
        ( itemno_acc = uv_itemno
          curr_type  = lc_curr_typ_10
          currency   = cv_waers
          amt_doccur = lv_amount_10 ) ).

    ENDIF.

  ELSE.

    "------------------------------------------------------------------*
    " Non-Split Posting Logic
    "------------------------------------------------------------------*

    " Basic GL item data
    ls_accountgl-itemno_acc = uv_itemno.
    ls_accountgl-alloc_nmbr = us_ls_data-field2.          "Allocation number
    ls_accountgl-tax_code   = us_ls_data-field7.
    ls_accountgl-taxjurcode = us_ls_data-field8.
    ls_accountgl-item_text  = us_ls_data-field9.
    ls_accountgl-gl_account = |{ us_ls_data-field10 ALPHA = IN }|.

    " Profit Center
    IF us_ls_data-field11 IS NOT INITIAL.
      ls_accountgl-profit_ctr = |{ us_ls_data-field11 ALPHA = IN }|.
    ENDIF.

    " Cost Center
    IF us_ls_data-field12 IS NOT INITIAL.
      ls_accountgl-costcenter = |{ us_ls_data-field12 ALPHA = IN }|.
    ENDIF.

    " Internal Order
    IF us_ls_data-field13 IS NOT INITIAL.
      ls_accountgl-orderid = |{ us_ls_data-field13 ALPHA = IN }|.
    ENDIF.

    " WBS Element
    IF us_ls_data-field14 IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_ABPSN_INPUT'
        EXPORTING
          input  = us_ls_data-field14
        IMPORTING
          output = ls_accountgl-wbs_element.
    ENDIF.

    " Functional Area
    ls_accountgl-func_area = us_ls_data-field15.

    " House Bank Account
    IF us_ls_data-field16 IS NOT INITIAL.
      ls_accountgl-housebankacctid = us_ls_data-field16.
    ENDIF.

    " Segment
    ls_accountgl-segment = us_ls_data-field17.

    " Trade ID
    IF us_ls_data-field18 IS NOT INITIAL.
      ls_accountgl-trade_id = |{ us_ls_data-field18 ALPHA = IN }|.
    ENDIF.

    " Material
    ls_accountgl-material = |{ us_ls_data-field19 ALPHA = IN }|.

    "------------------------------------------------------------------*
    " GL Master Validation (SKB1)
    "------------------------------------------------------------------*
    READ TABLE ut_skb1 ASSIGNING FIELD-SYMBOL(<lfs_skb1>)
         WITH KEY bukrs = us_documentheader-comp_code
                  saknr = ls_accountgl-gl_account
         BINARY SEARCH.

    IF <lfs_skb1> IS ASSIGNED
       AND <lfs_skb1>-xintb IS NOT INITIAL.

      " Error: Reconciliation account not allowed
      APPEND VALUE #(
        journal_id = uv_journal_id
        messtyp    = gc_err
        message    = |{ TEXT-039 }{ <lfs_skb1>-saknr }{ TEXT-040 }{ <lfs_skb1>-bukrs }| )
        TO ct_return_tmp.

      RETURN.
    ENDIF.

    "------------------------------------------------------------------*
    " Amount Calculation
    "------------------------------------------------------------------*
    IF us_ls_data-field3 = lc_debit.

      cv_total_amount      += us_ls_data-field4.
      ls_curramt-amt_doccur = us_ls_data-field4.

    ELSE.

      cv_total_amount      -= us_ls_data-field4.
      ls_curramt-amt_doccur = us_ls_data-field4 * -1.

    ENDIF.

    "------------------------------------------------------------------*
    " Currency Amount (Document Currency)
    "------------------------------------------------------------------*
    IF line_exists( ut_t001[ bukrs = us_documentheader-comp_code ] ).

      lv_amount_10 = ls_curramt-amt_doccur.

      ct_lt_curramt = VALUE #(
        BASE ct_lt_curramt
        ( itemno_acc = uv_itemno
          curr_type  = lc_curr_typ_10
          currency   = cv_waers
          amt_doccur = lv_amount_10 ) ).

    ENDIF.

    "------------------------------------------------------------------*
    " CO-PA / Additional Criteria
    "------------------------------------------------------------------*

    " Product Hierarchy
    IF us_ls_data-field20 IS NOT INITIAL.
      ls_criteria-fieldname  = gc_prdha.
      ls_criteria-itemno_acc = uv_itemno.
      ls_criteria-character  = us_ls_data-field20.
      APPEND ls_criteria TO ct_criteria.
      CLEAR ls_criteria.
    ENDIF.

    " Quantity
    ls_accountgl-quantity = us_ls_data-field21.

    " Base Unit of Measure
    IF us_ls_data-field26 IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          input    = us_ls_data-field22
          language = sy-langu
        IMPORTING
          output   = ls_accountgl-base_uom
        EXCEPTIONS
          OTHERS   = 2.
      IF sy-subrc <> 0.
        CLEAR ls_accountgl-base_uom.
      ENDIF.
    ENDIF.

    " Customer
    IF us_ls_data-field23 IS NOT INITIAL.
      READ TABLE ut_tvarvc INTO ls_tvarvc
           WITH KEY name = lc_kndnr
           BINARY SEARCH.
      IF sy-subrc = 0.
        ls_criteria-fieldname  = ls_tvarvc-low.
        ls_criteria-itemno_acc = uv_itemno.
        ls_criteria-character  = us_ls_data-field23.
        APPEND ls_criteria TO ct_criteria.
        CLEAR: ls_criteria, ls_tvarvc.
      ENDIF.
    ENDIF.

    " Plant
    IF us_ls_data-field24 IS NOT INITIAL.
      READ TABLE ut_tvarvc INTO ls_tvarvc
           WITH KEY name = lc_werks
           BINARY SEARCH.
      IF sy-subrc = 0.
        ls_criteria-fieldname  = ls_tvarvc-low.
        ls_criteria-itemno_acc = uv_itemno.
        ls_criteria-character  = us_ls_data-field24.
        APPEND ls_criteria TO ct_criteria.
        CLEAR: ls_criteria, ls_tvarvc.

        ls_accountgl-plant = us_ls_data-field24.
      ENDIF.
    ENDIF.

    " Cross-Company Transaction
    IF us_ls_data-field25 IS NOT INITIAL.
      ls_accountgl-cs_trans_t = us_ls_data-field25.
    ENDIF.

    " House Bank
    IF us_ls_data-field28 IS NOT INITIAL.
      ls_accountgl-housebankid = us_ls_data-field28.
    ENDIF.

    " Append GL item
    APPEND ls_accountgl TO ct_lt_accountgl.
    CLEAR ls_accountgl.

  ENDIF.

  CLEAR lv_amount_10.

ENDFORM.
