FORM sub_generate_tempate.

  TYPES: BEGIN OF lty_file_data,
           name      TYPE char200,
           timestamp TYPE char14,
         END OF lty_file_data.

  DATA: lt_file       TYPE TABLE OF eps2fili,
        lt_file_data  TYPE STANDARD TABLE OF lty_file_data.

  " Get the value of Directory name
  CALL FUNCTION 'ZALL_GET_ROOT_DIR'
    EXPORTING
      im_wricef             = gc_wricef
    IMPORTING
      ex_root_dir           = gv_directory
    EXCEPTIONS
      exc_no_root_directory = 1
      OTHERS                = 2.

  CALL FUNCTION 'EPS2_GET_DIRECTORY_LISTING'
    EXPORTING
      iv_dir_name            = gv_directory
    TABLES
      dir_list               = lt_file
    EXCEPTIONS
      invalid_eps_subdir     = 1
      sapgparam_failed       = 2
      build_directory_failed = 3
      no_authorization       = 4
      read_directory_failed  = 5
      too_many_read_errors   = 6
      empty_directory_list   = 7
      OTHERS                 = 8.

  IF sy-subrc = 0.

    LOOP AT lt_file INTO DATA(ls_data).

      IF ls_data-size > 0.
        lt_file_data = VALUE #(
          BASE lt_file_data
          (
            name      = ls_data-name
            timestamp = |{ ls_data-mtim+6(4) }{ ls_data-mtim+3(2) }{ ls_data-mtim+0(2) }|
                        && |{ ls_data-mtim+11(2) }{ ls_data-mtim+14(2) }{ ls_data-mtim+17(2) }|
          )
        ).
      ENDIF.

    ENDLOOP.

    IF lt_file_data IS NOT INITIAL.

      SORT lt_file_data BY timestamp DESCENDING.

      DATA(lv_template_name) =
        VALUE #( lt_file_data[ 1 ]-name OPTIONAL ).

      IF lv_template_name IS NOT INITIAL.
        " further processing
      ENDIF.

    ENDIF.

  ENDIF.

ENDFORM.


