*&---------------------------------------------------------------------*
*& Form  SUB_GET_DATA
*&---------------------------------------------------------------------*
FORM sub_get_data.

  "Raw Excel row (A–Z)
  TYPES: BEGIN OF lty_string,
           a TYPE string,
           b TYPE string,
           c TYPE string,
           d TYPE string,
           e TYPE string,
           f TYPE string,
           g TYPE string,
           h TYPE string,
           i TYPE string,
           j TYPE string,
           k TYPE string,
           l TYPE string,
           m TYPE string,
           n TYPE string,
           o TYPE string,
           p TYPE string,
           q TYPE string,
           r TYPE string,
           s TYPE string,
           t TYPE string,
           u TYPE string,
           v TYPE string,
           w TYPE string,
           x TYPE string,
           y TYPE string,
           z TYPE string,
         END OF lty_string.

  "Declarations
  DATA: lv_xstring   TYPE xstring,
        lo_excel     TYPE REF TO cl_fdt_xl_spreadsheet,
        lv_sheet_no  TYPE numc1 VALUE '1',
        lt_worksheet TYPE STANDARD TABLE OF string.

  FIELD-SYMBOLS <lfs_raw> TYPE STANDARD TABLE.

  "Upload file
  IF p_rapps = abap_true.
    PERFORM sub_data_apps CHANGING lv_xstring.
  ELSE.
    PERFORM sub_data_pres CHANGING lv_xstring.
  ENDIF.

  "Process Excel
  IF sy-subrc = 0 AND lv_xstring IS NOT INITIAL.

    lo_excel = NEW cl_fdt_xl_spreadsheet(
                  document_name = 'FILE'
                  xdocument     = lv_xstring ).

    lo_excel->if_fdt_doc_spreadsheet~get_worksheet_names(
      IMPORTING worksheet_names = lt_worksheet ).

    DATA(lv_sheet) = lt_worksheet[ lv_sheet_no ].

    DATA(lt_excel_table) =
      lo_excel->if_fdt_doc_spreadsheet~get_itab_from_worksheet( lv_sheet ).

    IF sy-subrc = 0.
      ASSIGN lt_excel_table->* TO <lfs_raw>.

      gt_data = CORRESPONDING #( <lfs_raw> MAPPING
                    field1  = a
                    field2  = b
                    field3  = c
                    field4  = d
                    field5  = e
                    field6  = f
                    field7  = g
                    field8  = h
                    field9  = i
                    field10 = j
                    field11 = k
                    field12 = l
                    field13 = m
                    field14 = n
                    field15 = o
                    field16 = p
                    field17 = q
                    field18 = r
                    field19 = s
                    field20 = t
                    field21 = u
                    field22 = v
                    field23 = w
                    field24 = x
                    field25 = y
                    field26 = z ).
    ENDIF.
  ENDIF.

ENDFORM.


