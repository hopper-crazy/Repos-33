"--------------------------------------------------------------------
" Remove COPA criteria for Balance Sheet GL accounts
"--------------------------------------------------------------------
IF ut_accountgl IS NOT INITIAL
   AND ct_criteria IS NOT INITIAL.

  " Fetch only Balance Sheet GLs (XBILK = 'X')
  SELECT saknr
    FROM ska1
    INTO TABLE @DATA(lt_bs_gl)
    FOR ALL ENTRIES IN @ut_accountgl
    WHERE saknr = @ut_accountgl-gl_account
      AND xbilk = @abap_true.

  IF sy-subrc = 0.

    " Use hashed table for fast lookup
    DATA lt_bs_gl_h TYPE HASHED TABLE OF saknr
                    WITH UNIQUE KEY table_line.
    lt_bs_gl_h = CORRESPONDING #( lt_bs_gl ).

    LOOP AT ut_accountgl INTO DATA(ls_accountgl).
      IF line_exists( lt_bs_gl_h[ table_line = ls_accountgl-gl_account ] ).
        DELETE ct_criteria
          WHERE itemno_acc = ls_accountgl-itemno_acc.
      ENDIF.
    ENDLOOP.

  ENDIF.
ENDIF.

