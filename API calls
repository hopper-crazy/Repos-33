FORM sub_get_gata.

  DATA:
    lv_xstring   TYPE xstring,                     "Excel file as XSTRING
    lo_excel     TYPE REF TO cl_fdt_xl_spreadsheet, "Excel handler
    lv_sheet_no  TYPE numc1 VALUE '1',              "Worksheet index
    lt_worksheet TYPE STANDARD TABLE OF string.     "Worksheet names

  "Fetch Excel binary data
  PERFORM sub_data_pres
    CHANGING
      lv_xstring.

  "Process Excel only if data is available
  IF sy-subrc = 0
     AND lv_xstring IS NOT INITIAL.

    lo_excel = NEW cl_fdt_xl_spreadsheet(
                  document_name = 'FILE'
                  xdocument     = lv_xstring ).

    "Get worksheet names
    lo_excel->if_fdt_doc_spreadsheet~get_worksheet_names(
      IMPORTING
        worksheet_names = lt_worksheet ).

    "Determine worksheet name
    DATA(lv_sheet) =
      VALUE #( lt_worksheet[ lv_sheet_no ] OPTIONAL ).

    "Read Excel data into dynamic internal table
    gt_excel_table =
      lo_excel->if_fdt_doc_spreadsheet~get_itab_from_worksheet(
        lv_sheet ).

    IF sy-subrc = 0.

      "Process based on Customer / Supplier selection
      IF p_cus = abap_true.
        PERFORM sub_extract_file_cust.
      ELSE.
        PERFORM sub_extract_file_supp.
      ENDIF.

    ENDIF.
  ENDIF.

ENDFORM.


